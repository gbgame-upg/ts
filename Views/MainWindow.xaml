<Window x:Class="QLHangTonKho.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QLHangTonKho.ViewModels"
        Title="Quản lý hàng tồn kho"
        WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>

                <!-- FOOTER sidebar -->
                <Border DockPanel.Dock="Bottom" Padding="16,10"
                        BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <!-- Nút đăng xuất -->
                    <Button x:Name="btnDangXuat"
                            Height="40" Cursor="Hand"
                            Background="#1E293B" BorderThickness="0"
                            Click="btnDangXuat_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#1E293B" CornerRadius="8"
                                        Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="  Đăng xuất" Foreground="#94A3B8"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- HEADER sidebar: thông tin user -->
                <Border DockPanel.Dock="Top" Background="#111827" Padding="16,20">
                    <StackPanel>
                        <!-- Avatar + tên -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="#2563EB">
                                <TextBlock x:Name="txtUserAvatar" Text="A"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtUserName" Text="Admin"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="14"/>
                                <Border x:Name="badgeNhom" CornerRadius="10"
                                        Padding="8,2" Margin="0,3,0,0"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="txtUserRole" Text="Admin"
                                               Foreground="White" FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tên hệ thống -->
                        <TextBlock Text="QUẢN LÝ KHO"
                                   Foreground="#94A3B8" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- MENU -->
                <StackPanel Margin="8,16,8,0">

                    <Button x:Name="btnTongQuan"
                            Content="🏠  Tổng quan"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnTongQuan_Click"/>

                    <Button x:Name="btnHangHoa"
                            Content="📦  Hàng hóa"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnHangHoa_Click"/>

                    <Button x:Name="btnNCC"
                            Content="🏢  Nhà cung cấp"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnNCC_Click"/>

                    <Button x:Name="btnNhap"
                            Content="📥  Phiếu nhập"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnNhap_Click"/>

                    <Button x:Name="btnXuat"
                            Content="📤  Phiếu xuất"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnXuat_Click"/>

                    <Button x:Name="btnBaoCao"
                            Content="📊  Báo cáo"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnBaoCao_Click"/>

                    <!-- Chỉ Admin mới thấy -->
                    <Separator Background="#1E293B" Margin="8,10"/>
                    <Button x:Name="btnQuanLyTK"
                            Content="👥  Quản lý tài khoản"
                            Height="46" FontSize="14" Margin="0,2"
                            Style="{StaticResource MenuButton}"
                            Click="btnQuanLyTK_Click"
                            Visibility="Collapsed"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Column="1" Background="#F1F5F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <TextBlock x:Name="txtTieuDe" Text="Tổng quan"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Border Grid.Row="1" Margin="16" CornerRadius="12" Background="Transparent">
                <ContentControl x:Name="contentArea"/>
            </Border>
        </Grid>

    </Grid>
</Window>
