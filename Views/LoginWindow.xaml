<Window x:Class="QLHangTonKho.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập — Quản lý kho"
        Width="820" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Màu chủ đạo -->
        <SolidColorBrush x:Key="PrimaryBlue"   Color="#3B6FD4"/>
        <SolidColorBrush x:Key="LightBlue"     Color="#E8F0FE"/>
        <SolidColorBrush x:Key="SoftGray"      Color="#F4F6FB"/>
        <SolidColorBrush x:Key="TextDark"      Color="#1A2B4A"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#8A97B0"/>

        <!-- TextBox style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="38,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#DDE3EF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2B4A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B6FD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox style -->
        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="38,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#DDE3EF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2B4A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B6FD4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#3B6FD4" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A5BC4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E4BAD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A97B0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Border CornerRadius="20" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ PANEL TRÁI — Form ════════════════ -->
            <Border Grid.Column="0" Background="White" CornerRadius="20,0,0,20">
                <Grid Margin="36,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo + Tiêu đề -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <!-- Icon kho -->
                        <Border Width="52" Height="52" CornerRadius="14"
                                Background="#E8F0FE" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="📦" FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Đăng nhập"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#1A2B4A"/>
                        <TextBlock x:Name="lblSubtitle"
                                   Text="Chào mừng đến Hệ thống Quản lý Kho"
                                   FontSize="12.5" Foreground="#8A97B0"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Tabs Đăng nhập / Đăng ký -->
                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnTabLogin" Grid.Column="0"
                                Content="Đăng nhập" Style="{StaticResource TabBtn}"
                                Click="TabLogin_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          Margin="0,0,0,6"/>
                                        <Border x:Name="underline" Height="3"
                                                Background="#3B6FD4" CornerRadius="2"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnTabRegister" Grid.Column="1"
                                Content="Đăng ký" Style="{StaticResource TabBtn}"
                                Click="TabRegister_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          Margin="0,0,0,6"/>
                                        <Border x:Name="underline" Height="3"
                                                Background="Transparent" CornerRadius="2"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ─── PANEL ĐĂNG NHẬP ─── -->
                    <StackPanel x:Name="panelLogin" Grid.Row="2">

                        <!-- Tên đăng nhập -->
                        <Grid Margin="0,0,0,14">
                            <TextBox x:Name="txtUsername" Style="{StaticResource InputBox}"
                                     Tag="Tên đăng nhập"/>
                            <TextBlock Text="👤" FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <!-- Placeholder -->
                            <TextBlock Text="Tên đăng nhập"
                                       Foreground="#B0BAC9" FontSize="13.5"
                                       VerticalAlignment="Center" Margin="40,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtUsername}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Mật khẩu -->
                        <Grid Margin="0,0,0,8">
                            <PasswordBox x:Name="txtPassword" Style="{StaticResource PwdBox}"/>
                            <TextBlock Text="🔒" FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Mật khẩu"
                                       Foreground="#B0BAC9" FontSize="13.5"
                                       VerticalAlignment="Center" Margin="40,0,0,0"
                                       IsHitTestVisible="False"
                                       x:Name="pwdPlaceholder"/>
                        </Grid>

                        <!-- Lỗi -->
                        <TextBlock x:Name="lblLoginError" Text=""
                                   Foreground="#E53E3E" FontSize="12.5"
                                   Margin="0,0,0,10" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>

                        <!-- Nút đăng nhập -->
                        <Button Content="Đăng nhập" Style="{StaticResource BtnPrimary}"
                                Margin="0,6,0,0" Click="btnDangNhap_Click"/>

                        <!-- Tài khoản mặc định hint -->
                        <Border Background="#F4F6FB" CornerRadius="8"
                                Padding="10,8" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 Tài khoản mặc định:"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#5A6A85" Margin="0,0,0,3"/>
                                <TextBlock FontSize="11.5" Foreground="#6B7A93">
                                    <Run Text="Admin: "/>
                                    <Run Text="admin" FontWeight="SemiBold" Foreground="#3B6FD4"/>
                                    <Run Text=" / "/>
                                    <Run Text="admin123" FontWeight="SemiBold" Foreground="#3B6FD4"/>
                                </TextBlock>
                                <TextBlock FontSize="11.5" Foreground="#6B7A93">
                                    <Run Text="NV: "/>
                                    <Run Text="nhanvien1" FontWeight="SemiBold" Foreground="#3B6FD4"/>
                                    <Run Text=" / "/>
                                    <Run Text="nhanvien1" FontWeight="SemiBold" Foreground="#3B6FD4"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ─── PANEL ĐĂNG KÝ ─── -->
                    <StackPanel x:Name="panelRegister" Grid.Row="2" Visibility="Collapsed">

                        <!-- Họ tên -->
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="txtRegHoTen" Style="{StaticResource InputBox}"/>
                            <TextBlock Text="👤" FontSize="15" VerticalAlignment="Center"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Họ và tên" Foreground="#B0BAC9" FontSize="13.5"
                                       VerticalAlignment="Center" Margin="40,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtRegHoTen}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Email -->
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="txtRegEmail" Style="{StaticResource InputBox}"/>
                            <TextBlock Text="✉️" FontSize="13" VerticalAlignment="Center"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Email (tuỳ chọn)" Foreground="#B0BAC9" FontSize="13.5"
                                       VerticalAlignment="Center" Margin="40,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtRegEmail}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Tên đăng nhập -->
                        <Grid Margin="0,0,0,12">
                            <TextBox x:Name="txtRegUsername" Style="{StaticResource InputBox}"/>
                            <TextBlock Text="🔑" FontSize="13" VerticalAlignment="Center"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Tên đăng nhập" Foreground="#B0BAC9" FontSize="13.5"
                                       VerticalAlignment="Center" Margin="40,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtRegUsername}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Mật khẩu -->
                        <Grid Margin="0,0,0,8">
                            <PasswordBox x:Name="txtRegPassword" Style="{StaticResource PwdBox}"/>
                            <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center"
                                       Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock x:Name="lblRegError" Text=""
                                   Foreground="#E53E3E" FontSize="12.5"
                                   Margin="0,0,0,8" Visibility="Collapsed"
                                   TextWrapping="Wrap"/>

                        <Button Content="Tạo tài khoản" Style="{StaticResource BtnPrimary}"
                                Margin="0,4,0,0" Click="btnDangKy_Click"/>

                        <TextBlock Text="* Tài khoản mới mặc định là Nhân viên."
                                   FontSize="11.5" Foreground="#8A97B0"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Nút đóng -->
                    <Button Grid.Row="3" Content="✕ Thoát" HorizontalAlignment="Left"
                            FontSize="12" Foreground="#8A97B0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Margin="0,12,0,0"
                            Click="btnThoat_Click"/>
                </Grid>
            </Border>

            <!-- ═══════════════ PANEL PHẢI — Illustration ════════════════ -->
            <Border Grid.Column="1" CornerRadius="0,20,20,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B6FD4" Offset="0"/>
                        <GradientStop Color="#6B9FEA" Offset="0.5"/>
                        <GradientStop Color="#A8C4F0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Vòng trang trí nền -->
                    <Ellipse Width="280" Height="280" HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" Margin="0,0,-80,-80"
                             Opacity="0.15" Fill="White"/>
                    <Ellipse Width="180" Height="180" HorizontalAlignment="Left"
                             VerticalAlignment="Top" Margin="-50,-50,0,0"
                             Opacity="0.12" Fill="White"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="30">

                        <!-- Illustration bằng shapes WPF -->
                        <Grid Width="200" Height="160" Margin="0,0,0,24">
                            <!-- Kệ hàng -->
                            <Rectangle Width="180" Height="120" VerticalAlignment="Bottom"
                                       Fill="White" Opacity="0.15" RadiusX="10" RadiusY="10"/>

                            <!-- Các hộp hàng -->
                            <Rectangle Width="40" Height="50" Fill="White" Opacity="0.4"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Margin="20,0,0,10" RadiusX="5" RadiusY="5"/>
                            <Rectangle Width="40" Height="65" Fill="White" Opacity="0.35"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Margin="68,0,0,10" RadiusX="5" RadiusY="5"/>
                            <Rectangle Width="40" Height="42" Fill="White" Opacity="0.45"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,22,10" RadiusX="5" RadiusY="5"/>

                            <!-- Icon + ký hiệu -->
                            <Border Width="50" Height="50" CornerRadius="25"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Margin="0,0,0,0" Background="White" Opacity="0.25"/>
                            <TextBlock Text="📦" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,10,0,0"/>
                        </Grid>

                        <!-- Text giới thiệu -->
                        <TextBlock Text="Hệ thống Quản lý Kho"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White" TextAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Quản lý hàng hóa, phiếu nhập xuất&#x0a;và báo cáo thống kê toàn diện"
                                   FontSize="13" Foreground="White" Opacity="0.85"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   LineHeight="22"/>

                        <!-- Các badge tính năng -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Border Background="White" Opacity="0.2" CornerRadius="20"
                                    Padding="12,6" Margin="4">
                                <TextBlock Text="📊 Báo cáo" Foreground="White" FontSize="12"/>
                            </Border>
                            <Border Background="White" Opacity="0.2" CornerRadius="20"
                                    Padding="12,6" Margin="4">
                                <TextBlock Text="🔐 Phân quyền" Foreground="White" FontSize="12"/>
                            </Border>
                            <Border Background="White" Opacity="0.2" CornerRadius="20"
                                    Padding="12,6" Margin="4">
                                <TextBlock Text="📦 Tồn kho" Foreground="White" FontSize="12"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
