<UserControl x:Class="QLHangTonKho.Views.PhieuXuatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QLHangTonKho.ViewModels" Height="480" Width="963">

    <UserControl.DataContext>
        <vm:PhieuXuatViewModel/>
    </UserControl.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,14">
            <Button Content="➕ Tạo phiếu xuất" Style="{StaticResource SuccessButton}"
                    Command="{Binding TaoPhieuCommand}" Margin="0,0,10,0"/>
            <Button Content="🔄 Làm mới" Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MASTER -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F4F8" Padding="12,8"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="📋 Danh sách phiếu xuất"
                                   FontWeight="SemiBold" Foreground="#1E2A38"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DanhSachPhieu}"
                              SelectedItem="{Binding SelectedPhieu}"
                              BorderThickness="0"
                              RowHeight="44"
                              ColumnHeaderHeight="48"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Margin="0,10,0,0">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã phiếu"
                                Binding="{Binding MaPhieuXuat}" Width="70"/>
                            <DataGridTextColumn Header="Lý do"
                                Binding="{Binding LyDo}"        Width="2*"/>
                            <DataGridTextColumn Header="Ngày xuất"
                                Binding="{Binding NgayXuat, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Tổng tiền"
                                Binding="{Binding TongTien, StringFormat={}{0:N0} ₫}"       Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- DETAIL -->
            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F4F8" Padding="12,8"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="📦 Chi tiết phiếu"
                                   FontWeight="SemiBold" Foreground="#1E2A38"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ChiTietPhieu}"
                              BorderThickness="0"
                              RowHeight="44"
                              ColumnHeaderHeight="48"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Margin="0,10,0,0">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên hàng"
                                Binding="{Binding TenHang}"   Width="*"/>
                            <DataGridTextColumn Header="SL"
                                Binding="{Binding SoLuong}"   Width="50"/>
                            <DataGridTextColumn Header="Đơn giá"
                                Binding="{Binding DonGia, StringFormat={}{0:N0} ₫}"    Width="110"/>
                            <DataGridTextColumn Header="Thành tiền"
                                Binding="{Binding ThanhTien, StringFormat={}{0:N0} ₫}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Padding="12,8" Background="#F8FAFC"
                            BorderBrush="#E0E6ED" BorderThickness="0,1,0,0">
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="#1E2A38">
                            <Run Text="Tổng tiền: "/>
                            <Run Text="{Binding TongTienPhieu, StringFormat={}{0:N0} ₫}"
                                 Foreground="#E74C3C"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

