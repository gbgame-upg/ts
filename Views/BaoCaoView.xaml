<UserControl x:Class="QLHangTonKho.Views.BaoCaoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QLHangTonKho.ViewModels">
    <UserControl.DataContext>
        <vm:BaoCaoViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Bộ lọc -->
        <Border Grid.Row="0" Background="White" CornerRadius="8"
                BorderBrush="#E0E6ED" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding TuNgay}" Margin="0,0,16,0" Width="130"/>
                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding DenNgay}" Margin="0,0,16,0" Width="130"/>
                <Button Content="📊 Xem báo cáo" Style="{StaticResource PrimaryButton}"
                        Command="{Binding XemBaoCaoCommand}" Margin="0,0,8,0"/>
                <Button Content="⚠️ Hàng sắp hết" Style="{StaticResource DangerButton}"
                        Command="{Binding XemHangSapHetCommand}"/>
            </WrapPanel>
        </Border>

        <!-- Thống kê nhanh -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tổng hàng hóa" Foreground="#7F8C9A" FontSize="12"/>
                    <TextBlock Text="{Binding TongHangHoa}" FontSize="24"
                               FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tổng nhập kho" Foreground="#7F8C9A" FontSize="12"/>
                    <TextBlock Text="{Binding TongNhap, StringFormat={}{0:N0} ₫}" FontSize="18"
                               FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tổng xuất kho" Foreground="#7F8C9A" FontSize="12"/>
                    <TextBlock Text="{Binding TongXuat, StringFormat={}{0:N0} ₫}" FontSize="18"
                               FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="Hàng sắp hết" Foreground="#7F8C9A" FontSize="12"/>
                    <TextBlock Text="{Binding SoHangSapHet}" FontSize="24"
                               FontWeight="Bold" Foreground="#E67E22"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bảng kết quả -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#E0E6ED" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F0F4F8" Padding="12,8"
                        CornerRadius="8,8,0,0">
                    <TextBlock Text="{Binding TieuDeBang}"
                               FontWeight="SemiBold" Foreground="#1E2A38"/>
                </Border>
                <DataGrid Grid.Row="1" BorderThickness="0"
                          ItemsSource="{Binding KetQua}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          RowHeight="44"
                          ColumnHeaderHeight="48"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Margin="0,10,0,0">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

