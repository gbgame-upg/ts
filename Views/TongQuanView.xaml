<UserControl x:Class="QLHangTonKho.Views.TongQuanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QLHangTonKho.ViewModels"
             Height="418" Width="779">

    <UserControl.DataContext>
        <vm:BaoCaoViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
        <StackPanel Margin="0">

            <!-- ── Stat cards ───────────────────────────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tổng hàng hóa -->
                <Border Grid.Column="0" Background="White" CornerRadius="10"
                        BorderBrush="#E0E6ED" BorderThickness="1" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="28"/>
                        <TextBlock Text="Tổng hàng hóa" Foreground="#7F8C9A"
                                   FontSize="12" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TongHangHoa}" FontSize="28"
                                   FontWeight="Bold" Foreground="#2980B9"/>
                    </StackPanel>
                </Border>

                <!-- Tổng nhập kho -->
                <Border Grid.Column="2" Background="White" CornerRadius="10"
                        BorderBrush="#E0E6ED" BorderThickness="1" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="📥" FontSize="28"/>
                        <TextBlock Text="Tổng nhập kho" Foreground="#7F8C9A"
                                   FontSize="12" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TongNhap, StringFormat={}{0:N0} ₫}"
                                   FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <!-- Tổng xuất kho -->
                <Border Grid.Column="4" Background="White" CornerRadius="10"
                        BorderBrush="#E0E6ED" BorderThickness="1" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="📤" FontSize="28"/>
                        <TextBlock Text="Tổng xuất kho" Foreground="#7F8C9A"
                                   FontSize="12" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding TongXuat, StringFormat={}{0:N0} ₫}"
                                   FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>

                <!-- Hàng sắp hết -->
                <Border Grid.Column="6" Background="White" CornerRadius="10"
                        BorderBrush="#E0E6ED" BorderThickness="1" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="⚠️" FontSize="28"/>
                        <TextBlock Text="Hàng sắp hết" Foreground="#7F8C9A"
                                   FontSize="12" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding SoHangSapHet}" FontSize="28"
                                   FontWeight="Bold" Foreground="#E67E22"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Bảng hàng sắp hết ────────────────────────────────── -->
            <Border Background="White" CornerRadius="10"
                    BorderBrush="#E0E6ED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FFF3E0" Padding="16,10"
                            CornerRadius="10,10,0,0">
                        <Grid>
                            <TextBlock Text="⚠️ Hàng hóa sắp hết — cần nhập thêm"
                                       FontWeight="SemiBold" Foreground="#E65100"/>
                            <!-- Nút làm mới -->
                            <Button Content="🔄 Làm mới"
                                    HorizontalAlignment="Right"
                                    Padding="10,2"
                                    Command="{Binding LoadCommand}"
                                    Background="Transparent"
                                    BorderBrush="#E65100"
                                    BorderThickness="1"
                                    Foreground="#E65100"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              BorderThickness="0"
                              MaxHeight="220"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding DanhSachSapHet}"
                              RowHeight="44"
                              ColumnHeaderHeight="48"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Margin="0,8,0,0">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên hàng"
                                Binding="{Binding TenHang}"     Width="*"/>
                            <DataGridTextColumn Header="Loại"
                                Binding="{Binding TenLoai}"     Width="120"/>
                            <DataGridTextColumn Header="ĐVT"
                                Binding="{Binding TenDVT}"      Width="70"/>
                            <DataGridTextColumn Header="Tồn kho"
                                Binding="{Binding SoLuongTon}"  Width="80"/>
                            <DataGridTextColumn Header="Mức tối thiểu"
                                Binding="{Binding MucToiThieu}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
