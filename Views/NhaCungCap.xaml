<UserControl x:Class="QLHangTonKho.Views.NhaCungCapView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QLHangTonKho.ViewModels"
        Height="600" Width="900"
       >
    <UserControl.DataContext>
        <vm:NhaCungCapViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" Padding="12,10"
                BorderBrush="#E0E6ED" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBox Width="220" Margin="0,0,8,0"
                         Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="🔍 Tìm kiếm" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                <Button Content="➕ Thêm mới" Style="{StaticResource SuccessButton}"
                        Command="{Binding AddCommand}" Margin="0,0,8,0"/>
                <Button Content="✏️ Sửa" Style="{StaticResource PrimaryButton}"
                        Command="{Binding UpdateCommand}" Margin="0,0,8,0"/>
                <Button Content="🗑️ Xóa" Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
                <Button Content="🔄 Làm mới" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}"/>
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="1" Margin="12"
                  ItemsSource="{Binding DanhSach}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="44"
                  ColumnHeaderHeight="48"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0">
            <DataGrid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã"          Binding="{Binding MaNCC}"     Width="50"/>
                <DataGridTextColumn Header="Tên NCC"     Binding="{Binding TenNCC}"    Width="*"/>
                <DataGridTextColumn Header="Địa chỉ"     Binding="{Binding DiaChi}"    Width="200"/>
                <DataGridTextColumn Header="Điện thoại"  Binding="{Binding DienThoai}" Width="110"/>
                <DataGridTextColumn Header="Email"       Binding="{Binding Email}"     Width="160"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="✅ Hợp tác"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                <Setter Property="Text"       Value="❌ Ngừng"/>
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

