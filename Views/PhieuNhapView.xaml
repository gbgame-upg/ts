<UserControl x:Class="QLHangTonKho.Views.PhieuNhapView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QLHangTonKho.ViewModels"
        Height="577" Width="837">

    <!-- FIX: Đổi từ NhaCungCapViewModel → PhieuNhapViewModel -->
    <UserControl.DataContext>
        <local:PhieuNhapViewModel/>
    </UserControl.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="➕ Tạo phiếu nhập" Style="{StaticResource SuccessButton}"
                    Command="{Binding TaoPhieuCommand}" Margin="0,0,8,0"/>
            <Button Content="🔄 Làm mới" Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoadCommand}"/>
        </WrapPanel>

        <!-- Master - Detail layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MASTER: Danh sách phiếu nhập -->
                <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F4F8" Padding="12,8"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="📋 Danh sách phiếu nhập"
                                   FontWeight="SemiBold" Foreground="#1E2A38"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DanhSachPhieu}"
                              SelectedItem="{Binding SelectedPhieu}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Margin="0,8,0,0"
                              RowHeight="44"
                              ColumnHeaderHeight="48"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã phiếu"
                                Binding="{Binding MaPhieuNhap}" Width="70"/>
                            <DataGridTextColumn Header="Nhà CC"
                                Binding="{Binding TenNCC}"      Width="2*"/>
                            <DataGridTextColumn Header="Ngày nhập"
                                Binding="{Binding NgayNhap, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Tổng tiền"
                                Binding="{Binding TongTien, StringFormat={}{0:N0} ₫}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- DETAIL: Chi tiết phiếu đang chọn -->
                <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E0E6ED" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F4F8" Padding="12,8"
                            CornerRadius="8,8,0,0">
                        <TextBlock Text="📦 Chi tiết phiếu"
                                   FontWeight="SemiBold" Foreground="#1E2A38"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ChiTietPhieu}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Margin="0,8,0,0"
                              RowHeight="44"
                              ColumnHeaderHeight="48"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên hàng"
                                Binding="{Binding TenHang}"   Width="*"/>
                            <DataGridTextColumn Header="SL"
                                Binding="{Binding SoLuong}"   Width="50"/>
                            <DataGridTextColumn Header="Đơn giá"
                                Binding="{Binding DonGia, StringFormat={}{0:N0} ₫}"     Width="110"/>
                            <DataGridTextColumn Header="Thành tiền"
                                Binding="{Binding ThanhTien, StringFormat={}{0:N0} ₫}"  Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Tổng tiền -->
                    <Border Grid.Row="2" Padding="12,8" Background="#F8FAFC"
                            BorderBrush="#E0E6ED" BorderThickness="0,1,0,0">
                        <TextBlock FontWeight="Bold" FontSize="14" Foreground="#1E2A38">
                            <Run Text="Tổng tiền: "/>
                            <Run Text="{Binding TongTienPhieu, StringFormat={}{0:N0} ₫}"
                                 Foreground="#2980B9"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
