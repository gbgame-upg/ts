<UserControl x:Class="QLHangTonKho.Views.HangHoaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QLHangTonKho.ViewModels"
        Background="#F5F7FA">
    <UserControl.DataContext>
        <local:HangHoaViewModel/>
    </UserControl.DataContext>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" Padding="16,12"
                CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">

                <TextBox Width="260" Height="38" FontSize="14"
                         Padding="10,5" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="🔍 Tìm kiếm" Height="38" FontSize="13"
                        Margin="0,0,8,0" Style="{DynamicResource PrimaryButton}"
                        Command="{Binding SearchCommand}"/>

                <!-- Ẩn 3 nút này nếu không có quyền sửa -->
                <Button Content="➕ Thêm mới" Height="38" FontSize="13"
                        Margin="0,0,8,0"
                        Command="{Binding AddCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{DynamicResource SuccessButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoQuyenSua}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="✏️ Sửa" Height="38" FontSize="13"
                        Margin="0,0,8,0" Command="{Binding UpdateCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{DynamicResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoQuyenSua}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🗑️ Xóa" Height="38" FontSize="13"
                        Margin="0,0,8,0" Command="{Binding DeleteCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{DynamicResource DangerButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoQuyenSua}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🔄 Làm mới" Height="38" FontSize="13"
                        Style="{DynamicResource PrimaryButton}"
                        Command="{Binding LoadCommand}"/>
            </WrapPanel>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="2" Background="White" CornerRadius="12"
                Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding DanhSach}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False"
                      FontSize="14" RowHeight="40"
                      ColumnHeaderHeight="44"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="White">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2563EB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã"       Binding="{Binding MaHang}"    Width="70"/>
                    <DataGridTextColumn Header="Tên hàng" Binding="{Binding TenHang}"   Width="*"/>
                    <DataGridTextColumn Header="Loại"     Binding="{Binding TenLoai}"   Width="140"/>
                    <DataGridTextColumn Header="ĐVT"      Binding="{Binding TenDVT}"    Width="80"/>
                    <DataGridTextColumn Header="Tồn kho"  Binding="{Binding SoLuongTon}" Width="90"/>
                    <DataGridTextColumn Header="Giá nhập" Binding="{Binding GiaNhap, StringFormat={}{0:N0} ₫}" Width="130"/>
                    <DataGridTextColumn Header="Giá bán"  Binding="{Binding GiaBan,  StringFormat={}{0:N0} ₫}" Width="130"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✅ Bình thường"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThaiTon}" Value="Sắp hết hàng">
                                                    <Setter Property="Text" Value="⚠️ Sắp hết"/>
                                                    <Setter Property="Foreground" Value="#EA580C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
