<Window x:Class="QLHangTonKho.Views.HangHoaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin hàng hóa"
        Width="480" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" x:Name="lblTitle"
                   Text="➕ Thêm hàng hóa mới"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,16"/>

        <!-- Form -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tên hàng -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên hàng *"
                       VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtTenHang"
                       Height="32" Padding="6,4" Margin="0,0,0,10"/>

            <!-- Loại hàng -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Loại hàng *"
                       VerticalAlignment="Center" Margin="0,0,0,10"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cboLoai"
                       Height="32" Margin="0,0,0,10"
                       DisplayMemberPath="TenLoai"
                       SelectedValuePath="MaLoai"/>

            <!-- Đơn vị tính -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Đơn vị tính *"
                       VerticalAlignment="Center" Margin="0,0,0,10"/>
            <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cboDVT"
                       Height="32" Margin="0,0,0,10"
                       DisplayMemberPath="TenDVT"
                       SelectedValuePath="MaDVT"/>

            <!-- Giá nhập -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Giá nhập (₫) *"
                       VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtGiaNhap"
                       Height="32" Padding="6,4" Margin="0,0,0,10" Text="0"/>

            <!-- Giá bán -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Giá bán (₫) *"
                       VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtGiaBan"
                       Height="32" Padding="6,4" Margin="0,0,0,10" Text="0"/>

            <!-- Mức tối thiểu -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Mức tối thiểu"
                       VerticalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtMucToiThieu"
                       Height="32" Padding="6,4" Margin="0,0,0,10" Text="5"/>

            <!-- Mô tả -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Mô tả"
                       VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtMoTa"
                       Height="56" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Height="34" Margin="0,0,10,0"
                    Click="btnHuy_Click"
                    Background="#F1F5F9" Foreground="#334155"
                    BorderBrush="#CBD5E1" BorderThickness="1"/>
            <Button Content="💾 Lưu" Width="100" Height="34"
                    Click="btnLuu_Click"
                    Background="#2563EB" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
