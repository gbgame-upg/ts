<Window x:Class="QLHangTonKho.Views.PhieuNhapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo phiếu nhập kho"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="📥 Tạo phiếu nhập kho mới"
                   FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

        <!-- Header phiếu -->
        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Nhà cung cấp *" Width="110" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cboNCC" Width="200" Height="32"
                              DisplayMemberPath="TenNCC" SelectedValuePath="MaNCC"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Ghi chú" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtGhiChu" Width="220" Height="32" Padding="6,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chi tiết nhập -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar thêm dòng -->
                <Border Grid.Row="0" Background="#F0F4F8" Padding="10,8" CornerRadius="8,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cboHang" Width="200" Height="30" Margin="0,0,8,0"
                                  DisplayMemberPath="TenHang" SelectedValuePath="MaHang"
                                  ToolTip="Chọn hàng hóa"/>
                        <TextBox x:Name="txtSoLuong" Width="70" Height="30" Padding="6,4"
                                 Margin="0,0,8,0" Text="1" ToolTip="Số lượng"/>
                        <TextBox x:Name="txtDonGia" Width="100" Height="30" Padding="6,4"
                                 Margin="0,0,8,0" Text="0" ToolTip="Đơn giá (₫)"/>
                        <Button Content="➕ Thêm dòng" Height="30" Padding="10,0"
                                Click="btnThemDong_Click"
                                Background="#16A34A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Danh sách chi tiết -->
                <DataGrid Grid.Row="1" x:Name="dgChiTiet"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          BorderThickness="0"
                          Margin="0,10,0,0"
                          RowHeight="44"
                          ColumnHeaderHeight="48"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên hàng"   Binding="{Binding TenHang}"  Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Số lượng"   Binding="{Binding SoLuong}"  Width="80"/>
                        <DataGridTextColumn Header="Đơn giá (₫)" Binding="{Binding DonGia}"  Width="120"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Xóa dòng -->
                <Border Grid.Row="2" Background="#F8FAFC" Padding="10,6"
                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🗑️ Xóa dòng đã chọn" Height="28" Padding="10,0"
                                Click="btnXoaDong_Click"
                                Background="#EF4444" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="lblTong" Text="Tổng: 0 ₫"
                                   VerticalAlignment="Center" Margin="20,0,0,0"
                                   FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Width="90" Height="34" Margin="0,0,10,0"
                    Click="btnHuy_Click"
                    Background="#F1F5F9" Foreground="#334155"
                    BorderBrush="#CBD5E1" BorderThickness="1"/>
            <Button Content="💾 Lưu phiếu" Width="120" Height="34"
                    Click="btnLuu_Click"
                    Background="#2563EB" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
