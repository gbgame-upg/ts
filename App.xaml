<Application x:Class="QLHangTonKho.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">

    <Application.Resources>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButton" TargetType="Button">

            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="40"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- SUCCESS BUTTON -->
        <Style x:Key="SuccessButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="#16A34A"/>

        </Style>

        <!-- DANGER BUTTON -->
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="#DC2626"/>

        </Style>

        <!-- MENU BUTTON -->
        <Style x:Key="MenuButton"
               TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Margin="8,4">

                            <ContentPresenter VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#1E293B"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#2563EB"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- GLOBAL TEXTBLOCK: tăng khoảng cách giữa các dòng/chữ -->
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- GLOBAL TEXTBOX: thêm padding/chiều cao mặc định để chữ không dính -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DATAGRID CELL: padding chuẩn cho các ô bảng -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- DATAGRID COLUMN HEADER: khoảng cách rộng hơn và căn giữa chữ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- DATAGRID ROW: khoảng cách hàng đều và đẹp hơn -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
        </Style>

        <!-- DATAGRID: mặc định cho tất cả các bảng -->
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="48"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="MinColumnWidth" Value="90"/>
        </Style>

    </Application.Resources>

</Application>
